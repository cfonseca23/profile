@page "/3d-retargeting"
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>3D Retargeting</PageTitle>

<div class="canvas-container">
    <canvas @ref="canvasRef"></canvas>

    <div class="live-state-panel">
        <h6>Estado live (.razor)</h6>
        <div>Fuente: @cfg.SourceUrl</div>
        <div>Destino: @cfg.TargetUrl</div>
        <div>Helpers: @(cfg.ShowHelpers ? "ON" : "OFF")</div>
        <div>Opacidad suelo: @cfg.ReflectorOpacity.ToString("F2", CultureInfo.InvariantCulture)</div>
        <div>Cámara Y: @cfg.CameraY.ToString("F2", CultureInfo.InvariantCulture)</div>
        <div>Cámara Z: @cfg.CameraZ.ToString("F2", CultureInfo.InvariantCulture)</div>
    </div>

    @if (loadError is not null)
    {
        <div class="model-error">
            No se pudieron cargar los modelos GLB definidos en el inspector de Three.js.
            <br />
            <small>@loadError</small>
        </div>
    }
</div>

<style>
    .canvas-container {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 60vh;
        flex: 1;
        overflow: hidden;
    }

    .canvas-container canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .model-error {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 60px;
        z-index: 10;
        background: rgba(120, 20, 20, 0.85);
        color: #fff;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 12px;
    }

    .live-state-panel {
        position: absolute;
        bottom: 12px;
        left: 12px;
        z-index: 10;
        min-width: 260px;
        max-width: min(520px, calc(100vw - 24px));
        background: rgba(9, 14, 22, 0.78);
        border: 1px solid rgba(0, 188, 212, 0.35);
        color: #d9eef2;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 12px;
        line-height: 1.45;
        backdrop-filter: blur(3px);
    }

    .live-state-panel h6 {
        margin: 0 0 6px;
        color: #6ad9e7;
        font-size: 12px;
        font-weight: 700;
    }

    /* El navbar sticky (z-index 1020) tapa el toggle del Inspector (top:15px, z-index 1001) */
    #profiler-toggle {
        top: 70px !important;
        z-index: 1021 !important;
    }

    #profiler-mini-panel {
        top: 112px !important;
    }
</style>

@code {
    private class Config
    {
        public string SourceUrl { get; set; } = "models/gltf/Michelle.glb";
        public string TargetUrl { get; set; } = "models/gltf/Soldier.glb";
        public bool ShowHelpers { get; set; }
        public double ReflectorOpacity { get; set; } = 0.2;
        public double CameraZ { get; set; } = 4;
        public double CameraY { get; set; } = 1;
    }

    private ElementReference canvasRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<Retargeting>? dotNetRef;
    private string? loadError;
    private Config cfg = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        dotNetRef = DotNetObjectReference.Create(this);
        var moduleUrl = new Uri(new Uri(Navigation.BaseUri), "js/three-bridge-retarget.js").ToString();
        module = await JS.InvokeAsync<IJSObjectReference>("import", moduleUrl);
        await InitScene();
    }

    private async Task InitScene()
    {
        if (module is null) return;
        loadError = null;
        await module.InvokeVoidAsync("initThree", canvasRef, new
        {
            sourceUrl = cfg.SourceUrl,
            targetUrl = cfg.TargetUrl,
            showHelpers = cfg.ShowHelpers,
            reflectorOpacity = cfg.ReflectorOpacity,
            cameraZ = cfg.CameraZ,
            cameraY = cfg.CameraY
        }, dotNetRef);
    }

    [JSInvokable]
    public Task OnConfigChanged(
        string sourceUrl,
        string targetUrl,
        bool showHelpers,
        double reflectorOpacity,
        double cameraY,
        double cameraZ)
    {
        cfg.SourceUrl = sourceUrl;
        cfg.TargetUrl = targetUrl;
        cfg.ShowHelpers = showHelpers;
        cfg.ReflectorOpacity = reflectorOpacity;
        cfg.CameraY = cameraY;
        cfg.CameraZ = cameraZ;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnModelLoadError(string message)
    {
        loadError = message;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("disposeThree");
            await module.DisposeAsync();
        }
        dotNetRef?.Dispose();
    }
}
