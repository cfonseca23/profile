@page "/3d-retargeting"
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>3D Retargeting</PageTitle>

<div class="canvas-container">
    <canvas @ref="canvasRef"></canvas>

    @if (loadError is not null)
    {
        <div class="model-error">
            No se pudieron cargar los modelos GLB. Revisa @cfg.SourceUrl y @cfg.TargetUrl en wwwroot.
            <br />
            <small>@loadError</small>
        </div>
    }

    <div class="config-panel @(isOpen ? "open" : "")">
        <button class="config-toggle" @onclick="() => isOpen = !isOpen" title="Configuración">
            @(isOpen ? "✕" : "⚙")
        </button>

        @if (isOpen)
        {
            <div class="config-body">
                <h6>Animation Retargeting</h6>

                <label class="checkbox-label">
                    <input type="checkbox" @bind="cfg.ShowHelpers" @bind:after="ApplyLive" />
                    Mostrar helpers (esqueletos)
                </label>

                <label>Opacidad reflejo suelo: @Inv(cfg.ReflectorOpacity, "F2")</label>
                <input type="range" min="0" max="1" step="0.05" value="@Inv(cfg.ReflectorOpacity)" @oninput="async e => { cfg.ReflectorOpacity = ParseDouble(e.Value, 0.2); await ApplyLive(); }" />

                <label>Cámara Z: @Inv(cfg.CameraZ, "F1")</label>
                <input type="range" min="3" max="12" step="0.5" value="@Inv(cfg.CameraZ)" @oninput="async e => { cfg.CameraZ = ParseDouble(e.Value, 4); await ApplyLive(); }" />

                <label>Cámara Y: @Inv(cfg.CameraY, "F1")</label>
                <input type="range" min="0" max="5" step="0.1" value="@Inv(cfg.CameraY)" @oninput="async e => { cfg.CameraY = ParseDouble(e.Value, 1); await ApplyLive(); }" />

                <label>Modelo fuente (animación)</label>
                <input type="text" @bind="cfg.SourceUrl" @bind:event="oninput" />

                <label>Modelo destino (retarget)</label>
                <input type="text" @bind="cfg.TargetUrl" @bind:event="oninput" />

                <div class="config-buttons">
                    <button class="btn-apply" @onclick="ReloadScene">Recargar modelos</button>
                    <button class="btn-reset" @onclick="ResetConfig">Reset</button>
                </div>

                <p class="inspector-hint">El panel del Inspector de three.js (perfilado, consola, parámetros) aparece como overlay flotante sobre el canvas.</p>
            </div>
        }
    </div>
</div>

<style>
    .canvas-container {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 60vh;
        flex: 1;
        overflow: hidden;
    }

    .canvas-container canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .model-error {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 60px;
        z-index: 10;
        background: rgba(120, 20, 20, 0.85);
        color: #fff;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 12px;
    }

    .config-panel {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 10;
    }

    .config-toggle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 188, 212, 0.85);
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .config-toggle:hover {
        background: #00bcd4;
    }

    .config-panel.open .config-toggle {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;
    }

    .config-body {
        background: rgba(18, 18, 24, 0.95);
        border: 1px solid rgba(0, 188, 212, 0.4);
        border-radius: 10px;
        padding: 50px 16px 16px;
        width: 260px;
        max-height: 70vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }

    .config-body h6 {
        margin: 0 0 8px;
        color: #00bcd4;
        font-size: 14px;
    }

    .config-body label {
        color: #aaa;
        font-size: 11px;
        margin-top: 4px;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #ddd !important;
        font-size: 12px !important;
    }

    .config-body input[type="text"] {
        padding: 6px 8px;
        border: 1px solid #444;
        border-radius: 4px;
        background: #1a1a24;
        color: #fff;
        font-size: 12px;
    }

    .config-body input[type="range"] {
        width: 100%;
        accent-color: #00bcd4;
    }

    .config-buttons {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-apply, .btn-reset {
        flex: 1;
        padding: 8px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
    }

    .btn-apply {
        background: #00bcd4;
        color: #fff;
    }

    .btn-reset {
        background: transparent;
        border: 1px solid #666;
        color: #aaa;
    }

    .btn-apply:hover { background: #00acc1; }
    .btn-reset:hover { border-color: #888; color: #fff; }

    .inspector-hint {
        margin-top: 10px;
        font-size: 10px !important;
        color: #777 !important;
        line-height: 1.4;
    }

    .config-body::-webkit-scrollbar { width: 5px; }
    .config-body::-webkit-scrollbar-thumb { background: #00bcd4; border-radius: 3px; }
</style>

@code {
    private ElementReference canvasRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<Retargeting>? dotNetRef;
    private bool isOpen = false;
    private string? loadError;
    private Config cfg = new();

    private static string Inv(double v, string fmt = "G") =>
        v.ToString(fmt, CultureInfo.InvariantCulture);

    private static double ParseDouble(object? value, double fallback) =>
        double.TryParse(value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var result)
            ? result : fallback;

    // Valores idénticos a DEFAULT_CONFIG en three-bridge-retarget.js
    private class Config
    {
        public string SourceUrl { get; set; } = "models/gltf/Michelle.glb";
        public string TargetUrl { get; set; } = "models/gltf/Soldier.glb";
        public bool ShowHelpers { get; set; } = false;
        public double ReflectorOpacity { get; set; } = 0.2;
        public double CameraZ { get; set; } = 4;
        public double CameraY { get; set; } = 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        dotNetRef = DotNetObjectReference.Create(this);
        var moduleUrl = new Uri(new Uri(Navigation.BaseUri), "js/three-bridge-retarget.js").ToString();
        module = await JS.InvokeAsync<IJSObjectReference>("import", moduleUrl);
        await InitScene();
    }

    private async Task InitScene()
    {
        if (module is null) return;
        loadError = null;
        await module.InvokeVoidAsync("initThree", canvasRef, new
        {
            sourceUrl = cfg.SourceUrl,
            targetUrl = cfg.TargetUrl,
            showHelpers = cfg.ShowHelpers,
            reflectorOpacity = cfg.ReflectorOpacity,
            cameraZ = cfg.CameraZ,
            cameraY = cfg.CameraY
        }, dotNetRef);
    }

    private async Task ApplyLive()
    {
        if (module is null) return;
        await module.InvokeVoidAsync("updateConfig", new
        {
            showHelpers = cfg.ShowHelpers,
            reflectorOpacity = cfg.ReflectorOpacity,
            cameraZ = cfg.CameraZ,
            cameraY = cfg.CameraY
        });
    }

    private async Task ReloadScene()
    {
        if (module is null) return;
        await module.InvokeVoidAsync("disposeThree");
        await Task.Delay(50);
        await InitScene();
    }

    private async Task ResetConfig()
    {
        cfg = new Config();
        StateHasChanged();
        await ReloadScene();
    }

    [JSInvokable]
    public void OnModelLoadError(string message)
    {
        loadError = message;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("disposeThree");
            await module.DisposeAsync();
        }
        dotNetRef?.Dispose();
    }
}
